{
  "expo": {
    "name": "Silent Support",
    "slug": "silent-support",
    "scheme": "silentsupport",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/ios_icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0F1A"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Literata-Light.ttf",
            "./assets/fonts/Literata-Regular.ttf",
            "./assets/fonts/Literata-Medium.ttf",
            "./assets/fonts/Literata-Italic.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F1A"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.silentsupport.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F1A",
        "foregroundImage": "./assets/android_adaptive_foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0E0F1A"
  }
}
